rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || exists(/databases/$(database)/documents/Admin/$(request.auth.uid))
        );
    }

    function isBanned(uid) {
      return exists(/databases/$(database)/documents/banned_users/$(uid));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userParticipant() {
      return 'user_' + request.auth.uid;
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data.participants != null
        && userParticipant() in data.participants;
    }

    // Admin roster — only readable by the signed-in user checking their own doc.
    // Create the first admin in Firebase Console: collection "admins", doc ID = your Firebase UID.
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Banned users — admins manage; users can read only their own ban status.
    match /banned_users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // User profiles — authenticated read; owner write unless banned.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && !isBanned(userId);
      allow update: if isOwner(userId) && !isBanned(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && !isBanned(request.auth.uid);
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && !isBanned(request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && !isBanned(request.auth.uid);
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid
        && !isBanned(request.auth.uid);
    }

    match /conversations/{convoId} {
      allow read: if isAdmin()
        || isConversationParticipant(resource.data);
      allow create: if signedIn()
        && isConversationParticipant(request.resource.data);
      allow update: if isAdmin()
        || isConversationParticipant(resource.data);
      allow delete: if isAdmin();
    }

    // Public catalog/content — anyone can read; only admins can write.
    match /admin/{docId} {
      allow read: if docId == 'settings' || signedIn();
      allow write: if isAdmin();
    }
    match /admin_celeb_overrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_added_celebs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_post_overrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
