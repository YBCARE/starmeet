# Copy to .env and fill in your Stripe keys (Dashboard → Developers → API keys)
# Payment Links: Dashboard → Payment Links → set success URL to:
#   https://starmeet.online/upgrade-success?plan=pro
#   https://starmeet.online/upgrade-success?plan=celebrity

VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
VITE_STRIPE_LINK_PRO=https://buy.stripe.com/YOUR_PRO_LINK
VITE_STRIPE_LINK_CELEBRITY=https://buy.stripe.com/YOUR_CELEBRITY_LINK
